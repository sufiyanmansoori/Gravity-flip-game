components:
  schemas:
    Achievement:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        code:
          type: string
          maxLength: 80
          pattern: ^[-a-zA-Z0-9_]+$
        name:
          type: string
          maxLength: 120
        description:
          type: string
        icon:
          type: string
          maxLength: 255
        points:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
        criteria: {}
        is_hidden:
          type: boolean
        rewards:
          type: array
          items:
            $ref: '#/components/schemas/AchievementReward'
          readOnly: true
        unlocked:
          type: string
          readOnly: true
      required:
      - code
      - id
      - name
      - rewards
      - unlocked
    AchievementReward:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        reward_type:
          $ref: '#/components/schemas/RewardTypeEnum'
        amount:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
        reference:
          type: string
          maxLength: 120
        payload: {}
      required:
      - id
      - reward_type
    ActionEnum:
      enum:
      - none
      - warn
      - suspend
      - ban
      type: string
      description: |-
        * `none` - None
        * `warn` - Warn
        * `suspend` - Suspend
        * `ban` - Ban
    ChallengeAttempt:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        user:
          type: integer
        challenge:
          type: integer
        score:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
        completed:
          type: boolean
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - challenge
      - created_at
      - id
      - user
    ChannelEnum:
      enum:
      - in_app
      - email
      - sms
      - push
      type: string
      description: |-
        * `in_app` - In app
        * `email` - Email
        * `sms` - SMS
        * `push` - Push
    CreateLevel:
      type: object
      properties:
        slug:
          type: string
          maxLength: 100
          pattern: ^[-a-zA-Z0-9_]+$
        title:
          type: string
          maxLength: 150
        description:
          type: string
          default: ''
        difficulty:
          type: integer
        seed:
          type: integer
          minimum: 0
          default: 0
        definition: {}
        configuration:
          $ref: '#/components/schemas/LevelConfig'
      required:
      - difficulty
      - slug
      - title
    DailyChallenge:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        title:
          type: string
          maxLength: 255
        description:
          type: string
        target_score:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
        expires_at:
          type: string
          format: date-time
        is_active:
          type: boolean
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - expires_at
      - id
      - title
    GameLevel:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 255
        slug:
          type: string
          maxLength: 50
          pattern: ^[-a-zA-Z0-9_]+$
        difficulty:
          type: string
          maxLength: 50
        gravity_direction:
